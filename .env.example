# Settings for compose.yaml. Copy this file to .env (which git ignores) and edit it there:
#
#   cp .env.example .env

# Password of the wildcat PostgreSQL user. "change-me" is a placeholder, not a default: pick your
# own before the first start. PostgreSQL applies it only when it creates the postgres-data volume,
# and compose pastes it into the host's connection string, so use letters, digits, - and _ only.
POSTGRES_PASSWORD=change-me

# Environment the host runs in (default Production, which seeds nothing). Development also loads
# appsettings.Development.json, which seeds a sample developer and game with well-known keys, so
# use it only on your own machine.
# ASPNETCORE_ENVIRONMENT=Development

# Every variable in this file is also passed to the host, so any setting from the configuration
# table in README.md can go here, with __ between section names. For example SMTP, without which
# activation and password reset codes are only written to the log:
# WildCat__Email__SmtpHost=smtp.example.com
# WildCat__Email__UserName=
# WildCat__Email__Password=
# WildCat__Email__FromAddress=noreply@example.com
